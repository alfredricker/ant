{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.post_id, c.author_id, u.username AS author_username,\n                c.body, c.created_at, c.updated_at\n         FROM post_comments c JOIN users u ON u.id = c.author_id\n         WHERE c.post_id = $1\n         ORDER BY c.created_at\n         LIMIT 500",
