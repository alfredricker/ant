{
  "db_name": "PostgreSQL",
  "query": "WITH c AS (\n               INSERT INTO post_comments (post_id, author_id, body) VALUES ($1, $2, $3)\n               RETURNING *\n           )\n           SELECT c.id, c.post_id, c.author_id, u.username AS author_username,\n                  c.body, c.created_at, c.updated_at\n           FROM c JOIN users u ON u.id = c.author_id",
