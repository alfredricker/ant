  "query": "SELECT id, conversation_id, sender_id, body, created_at FROM messages\n         WHERE conversation_id = $1 AND ($2::timestamptz IS NULL OR created_at < $2)\n         ORDER BY created_at DESC\n         LIMIT $3",
