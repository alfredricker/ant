# Dev defaults. Safe to commit — never used outside of local docker.
ENVIRONMENT=dev

# --- postgres ---
POSTGRES_USER=ant
POSTGRES_PASSWORD=ant
POSTGRES_DB=ant
POSTGRES_PORT=5432

# --- app ---
APP_PORT=6353
RUST_LOG=debug,sqlx=warn
# Where browsers reach the stack; Google redirects back to
# $PUBLIC_URL/api/auth/google/callback.
PUBLIC_URL=http://localhost:8080

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET are real secrets: put them in
# env/.env.local (gitignored), not here. Without them Google sign-in is off.

# --- nginx (host port the stack is reachable on) ---
NGINX_PORT=8080
